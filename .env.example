# Expo Environment Variables for RoadRider Native App
# Public variables accessible in client-side code prefix with EXPO_PUBLIC_

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Google Maps API Key (Client / Native)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
